rules_version = '2';

// TEMPORARY — see firestore.care-plus.rules for the full explanation.
// Firebase Authentication is currently disabled, so `request.auth` is
// always null here too. This rule intentionally does not check it (an
// auth check here would make every upload fail with permission-denied).
// Restore the `request.auth != null` condition once Firebase
// Authentication is re-enabled.

service firebase.storage {
  match /b/{bucket}/o {
    // Home visit photos and map images.
    match /home-visits/{studentId}/{fileName} {
      allow read: if true;
      // request.resource is null on delete, so a delete must be its own
      // branch — folding it into `write` alongside the size/type check
      // would evaluate that check against a null resource and always deny.
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Homeroom activity log photos.
    match /homeroom-logs/{classId}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
