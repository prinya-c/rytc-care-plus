# Firebase project config (Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Turnstile site key (public, safe to expose client-side).
# The matching TURNSTILE_SECRET_KEY is NOT a Vite env var — it's set as a
# Cloudflare Pages environment variable instead, and only ever read by
# functions/api/verify-turnstile.js on the Cloudflare deploy.
VITE_TURNSTILE_SITE_KEY=
